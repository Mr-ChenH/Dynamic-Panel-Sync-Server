# Compose-time secrets. Copy to .compose.env, set mode 0600, and replace every empty value.
DP_POSTGRES_ADMIN_PASSWORD=
DP_POSTGRES_APP_PASSWORD=
# Base64-encoded 32-byte key, for example: openssl rand -base64 32
DP_BACKUP_MASTER_KEY=

# Registry image and host binding overrides.
DP_SYNC_IMAGE=ghcr.io/mr-chenh/dynamic-panel-sync-server:latest
DP_BIND_ADDRESS=127.0.0.1
DP_BIND_PORT=43822
